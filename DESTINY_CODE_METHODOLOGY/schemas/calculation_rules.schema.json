{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "id",
    "version",
    "status",
    "dateInput",
    "reduction",
    "rules",
    "alternateProfiles"
  ],
  "properties": {
    "id": {
      "const": "C-family-center-v1"
    },
    "version": {
      "const": "dc-symbolic-1.0.0-proposed"
    },
    "status": {
      "const": "research_candidate"
    },
    "rules": {
      "type": "array",
      "minItems": 38,
      "maxItems": 38,
      "items": {
        "type": "object",
        "required": [
          "id",
          "inputs",
          "operation",
          "provenance",
          "status"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "inputs": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "operation": {
            "enum": [
              "reduce",
              "identity",
              "digit_sum_then_reduce",
              "sum_reduce"
            ]
          },
          "provenance": {
            "type": "object",
            "required": [
              "classification",
              "sourceRefs",
              "editorialNote"
            ],
            "properties": {
              "classification": {
                "enum": [
                  "shared",
                  "source_specific",
                  "conflicting",
                  "editorial_synthesis",
                  "unsupported"
                ]
              },
              "sourceRefs": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "sourceId",
                    "pdfPages"
                  ],
                  "properties": {
                    "sourceId": {
                      "enum": [
                        "A",
                        "B",
                        "C"
                      ]
                    },
                    "pdfPages": {
                      "type": "array",
                      "minItems": 1,
                      "items": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 352
                      }
                    }
                  },
                  "additionalProperties": false
                }
              },
              "editorialNote": {
                "type": "string"
              }
            },
            "additionalProperties": false
          },
          "status": {
            "const": "verified_for_proposed_C_profile"
          }
        }
      }
    },
    "alternateProfiles": {
      "type": "array"
    }
  }
}
