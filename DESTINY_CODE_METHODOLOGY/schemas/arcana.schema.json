{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "array",
  "minItems": 22,
  "maxItems": 22,
  "items": {
    "type": "object",
    "required": [
      "id",
      "number",
      "name",
      "coreSymbolicMeaning",
      "constructiveManifestations",
      "shadowManifestations",
      "domainReadings",
      "positionSpecificRules",
      "sourceRefs",
      "provenance"
    ],
    "properties": {
      "id": {
        "type": "string",
        "pattern": "^arcana_(0[1-9]|1[0-9]|2[0-2])$"
      },
      "number": {
        "type": "integer",
        "minimum": 1,
        "maximum": 22
      },
      "name": {
        "type": "string",
        "minLength": 1
      },
      "domainReadings": {
        "type": "object",
        "required": [
          "portrait",
          "core",
          "talent",
          "money",
          "relationship",
          "family",
          "growth",
          "desire",
          "balance",
          "purpose"
        ],
        "additionalProperties": {
          "type": "string",
          "minLength": 1
        }
      },
      "sourceRefs": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "object",
          "required": [
            "sourceId",
            "pdfPages"
          ],
          "properties": {
            "sourceId": {
              "enum": [
                "A",
                "B",
                "C"
              ]
            },
            "pdfPages": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "integer",
                "minimum": 1,
                "maximum": 352
              }
            }
          },
          "additionalProperties": false
        }
      },
      "provenance": {
        "type": "object",
        "required": [
          "classification",
          "sourceRefs",
          "editorialNote"
        ],
        "properties": {
          "classification": {
            "enum": [
              "shared",
              "source_specific",
              "conflicting",
              "editorial_synthesis",
              "unsupported"
            ]
          },
          "sourceRefs": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "sourceId",
                "pdfPages"
              ],
              "properties": {
                "sourceId": {
                  "enum": [
                    "A",
                    "B",
                    "C"
                  ]
                },
                "pdfPages": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 352
                  }
                }
              },
              "additionalProperties": false
            }
          },
          "editorialNote": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    }
  }
}
