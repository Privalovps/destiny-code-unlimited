{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "array",
  "minItems": 10,
  "items": {
    "type": "object",
    "required": [
      "id",
      "date",
      "values",
      "trace",
      "expectedABAncestry"
    ],
    "properties": {
      "date": {
        "type": "string",
        "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
      },
      "values": {
        "type": "object",
        "minProperties": 38,
        "maxProperties": 38,
        "additionalProperties": {
          "type": "integer",
          "minimum": 1,
          "maximum": 22
        }
      },
      "trace": {
        "type": "array",
        "minItems": 38,
        "maxItems": 38,
        "items": {
          "type": "object",
          "required": [
            "formulaId",
            "inputs",
            "operands",
            "rawValue",
            "reductionSteps",
            "result"
          ],
          "properties": {
            "result": {
              "type": "integer",
              "minimum": 1,
              "maximum": 22
            },
            "rawValue": {
              "type": "integer",
              "minimum": 1
            },
            "operands": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "integer",
                "minimum": 1
              }
            },
            "reductionSteps": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "integer",
                "minimum": 1
              }
            }
          }
        }
      }
    }
  }
}
