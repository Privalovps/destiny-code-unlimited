{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "array",
  "minItems": 26,
  "maxItems": 26,
  "items": {
    "type": "object",
    "required": [
      "id",
      "match",
      "title",
      "symbolicReading",
      "practice",
      "provenance"
    ],
    "properties": {
      "match": {
        "type": "object",
        "required": [
          "orderedValues",
          "nodeOrder"
        ],
        "properties": {
          "orderedValues": {
            "type": "array",
            "minItems": 3,
            "maxItems": 3,
            "items": {
              "type": "integer",
              "minimum": 1,
              "maximum": 22
            }
          },
          "nodeOrder": {
            "const": [
              "bottom",
              "bottom_inner",
              "bottom_mid"
            ]
          }
        }
      },
      "provenance": {
        "type": "object",
        "required": [
          "classification",
          "sourceRefs",
          "editorialNote"
        ],
        "properties": {
          "classification": {
            "enum": [
              "shared",
              "source_specific",
              "conflicting",
              "editorial_synthesis",
              "unsupported"
            ]
          },
          "sourceRefs": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "sourceId",
                "pdfPages"
              ],
              "properties": {
                "sourceId": {
                  "enum": [
                    "A",
                    "B",
                    "C"
                  ]
                },
                "pdfPages": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 352
                  }
                }
              },
              "additionalProperties": false
            }
          },
          "editorialNote": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    }
  }
}
