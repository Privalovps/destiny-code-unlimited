{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "array",
  "minItems": 1,
  "items": {
    "type": "object",
    "required": [
      "id",
      "order",
      "title",
      "positionIds",
      "combinationRuleIds",
      "purpose",
      "access",
      "provenance"
    ],
    "properties": {
      "order": {
        "type": "integer",
        "minimum": 1
      },
      "access": {
        "const": "paid"
      },
      "positionIds": {
        "type": "array",
        "uniqueItems": true,
        "items": {
          "type": "string"
        }
      },
      "combinationRuleIds": {
        "type": "array",
        "uniqueItems": true,
        "items": {
          "type": "string"
        }
      },
      "provenance": {
        "type": "object",
        "required": [
          "classification",
          "sourceRefs",
          "editorialNote"
        ],
        "properties": {
          "classification": {
            "enum": [
              "shared",
              "source_specific",
              "conflicting",
              "editorial_synthesis",
              "unsupported"
            ]
          },
          "sourceRefs": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "sourceId",
                "pdfPages"
              ],
              "properties": {
                "sourceId": {
                  "enum": [
                    "A",
                    "B",
                    "C"
                  ]
                },
                "pdfPages": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 352
                  }
                }
              },
              "additionalProperties": false
            }
          },
          "editorialNote": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    }
  }
}
